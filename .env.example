# DocPilot configuration. Copy to .env (never commit .env).
# Everything below has a working default: no API keys or accounts are required.

# --- runtime ---------------------------------------------------------------------------
APP_ENV=local                      # local | test | production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=                      # comma-separated, e.g. http://localhost:5173
RUN_WORKER_IN_PROCESS=false        # true = API also consumes ingestion events (single-process mode)

# --- datastores ------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://docpilot:docpilot@localhost:5432/docpilot
REDIS_URL=redis://localhost:6379/0

# --- event bus -------------------------------------------------------------------------
EVENT_BUS=kafka                    # kafka | memory
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT  # SASL_SSL for a managed cluster
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_INGEST=docpilot.documents.uploaded.v1
KAFKA_TOPIC_DLQ=docpilot.documents.uploaded.v1.dlq
KAFKA_TOPIC_PARTITIONS=6
KAFKA_CONSUMER_GROUP=docpilot-ingest-workers

# --- object storage (MinIO locally; any S3-compatible store) ---------------------------
STORAGE_BACKEND=s3                 # s3 | local | memory
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=docpilot-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
LOCAL_STORAGE_PATH=.data/blobs
MAX_UPLOAD_MB=20

# --- auth & rate limiting --------------------------------------------------------------
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789   # set 32+ random chars in production
JWT_TTL_MINUTES=60
RATE_LIMIT_CAPACITY=60             # token-bucket burst size per tenant
RATE_LIMIT_REFILL_PER_SEC=1.0      # sustained requests/second per tenant
SIGNUP_ENABLED=true

# --- ingestion -------------------------------------------------------------------------
CHUNK_MAX_TOKENS=320
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP_SENTENCES=1
CHUNK_TOPIC_SHIFT_THRESHOLD=0.08
INGEST_MAX_ATTEMPTS=4
INGEST_BACKOFF_BASE_SECONDS=0.5
INGEST_BACKOFF_MAX_SECONDS=20
INGEST_LEASE_SECONDS=300
INGEST_CONCURRENCY=4
WORKER_METRICS_PORT=9100

# --- embeddings (local by default) -----------------------------------------------------
EMBEDDING_PROVIDER=fastembed       # fastembed (local ONNX) | hashing (offline fallback) | openai (optional)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=              # pre-downloaded model dir; the Docker image bakes one in
EMBEDDING_CACHE_DIR=.models
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
OPENAI_API_KEY=                    # optional — only used if set and selected
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- retrieval -------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=30
RRF_K=60
MIN_VECTOR_SIMILARITY=0.15
RERANKER=none                      # none | cross_encoder (local fastembed model)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- generation (no key needed by default) ---------------------------------------------
LLM_PROVIDER=auto                  # auto | extractive | echo | ollama | openai | anthropic
LLM_MODEL=                         # provider default when empty
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0
OLLAMA_BASE_URL=http://localhost:11434   # LLM_PROVIDER=ollama, e.g. LLM_MODEL=qwen2.5:1.5b
ANTHROPIC_API_KEY=                 # optional — `auto` uses Anthropic only if this is set
ANTHROPIC_EFFORT=low               # low | medium | high | xhigh | max (Claude thinking depth)
ANTHROPIC_MAX_TOKENS=8000          # includes thinking tokens

# --- caching ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- observability ---------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
